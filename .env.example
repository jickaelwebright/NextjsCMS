# Copy this file to .env.local and fill in your values.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=please-change-this-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# ── Super Admin ───────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@cms.local
SUPERADMIN_PASSWORD=changeme123

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path to the directory where per-tenant SQLite databases are stored.
# Must be writable by the Node.js process and outside public_html on cPanel.
# DATA_DIR=/home/username/cms-data

# ── AI Integration (optional — can also be set per-tenant in Settings) ────────
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_NIM_API_KEY=nvapi-...
# GEMINI_API_KEY=AIza...
